<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Large models -->
    <exclude domain="file" path="canary/" />
    <exclude domain="file" path="nemotron/" />
    <exclude domain="file" path="nemotron-160/" />
    <exclude domain="file" path="nemotron-560/" />
    <exclude domain="file" path="fastconformer/" />
    <exclude domain="file" path="whisper-tiny/" />
    <exclude domain="file" path="vocab/" />
    <!-- BYOK secrets: encrypted in noBackupFilesDir/api_secrets — never backed up. DataStore contains only refs, not plaintext. -->
    <exclude domain="file" path="api_secrets/" />
    <!-- DataStore is the real prefs location, not SharedPreferences. Exclude its file explicitly. -->
    <exclude domain="file" path="datastore/sprich_prefs.preferences_pb" />
    <exclude domain="sharedpref" path="sprich_prefs.xml" />
    <exclude domain="sharedpref" path="sprich_vocab.xml" />
</full-backup-content>
